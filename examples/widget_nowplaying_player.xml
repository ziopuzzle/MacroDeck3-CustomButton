<stack id="container" direction="vertical" background="#1a1a1a">
  <layer id="player" visible="true" visibleWhen="connected == true">
    <image id="artwork" source="{{artwork}}" size="100%" brightness="0.5" saturation="1" transition="crossfade" fit="contain" />
    <stack id="uiAll" direction="horizontal">
      <slider id="volume" key="volume" mainSize="0.1" direction="vertical" min="0" max="100" interactive="true" visible="true" visibleWhen="showVolume == true" />
      <stack id="uiPlayer" padding="3%" gap="0%" justify="space-between">
        <stack id="ui_text" direction="vertical" fill="true" justify="center">
          <stack id="titleLabel" direction="vertical" padding="2%" gap="1%" background="#00000080">
            <text id="title" size="10%" align="center" maxLines="3">{{title}}</text>
            <text id="artist" size="6%" align="center" maxLines="2" color="#999999">{{artist}}</text>
          </stack>
        </stack>
        <stack id="uiMusicControl" direction="vertical" justify="end">
          <stack id="controls" direction="horizontal" mainSize="auto" gap="3%">
            <stack id="previous" interactive="true" fill="true" padding="5%" justify="center" align="center">
              <transform id="transform1" rotation="180">
                <icon id="previousLabel" name="chevron-right" size="15%" />
              </transform>
            </stack>
            <stack id="playPause" interactive="true" justify="center" align="center" fill="true" padding="5%">
              <icon id="playLabel" name="play" size="15%" visible="true" visibleWhen="playing == false" />
              <icon id="pauseLabel" name="pause" size="15%" visible="true" visibleWhen="playing == true" />
            </stack>
            <stack id="next" interactive="true" justify="center" align="center" fill="true" padding="5%">
              <icon id="nextLabel" name="chevron-right" size="15%" />
            </stack>
          </stack>
          <stack id="spacer1" direction="vertical" padding="3%" />
          <stack id="progress_container" direction="vertical" gap="5%">
            <slider id="progress" key="position" min="0" max="{{= max(1,duration)}}" step="1" color="#8c8c92" interactive="true" thickness="5%" />
            <stack id="duration_wrapper" direction="vertical" justify="end" align="end">
              <text id="position_mmss" size="10%" align="end" visible="true" visibleWhen="duration == 0 and position &lt; 3600">{{position:duration:mm:ss}}</text>
              <text id="position_hhmmss" size="10%" align="end" visible="true" visibleWhen="duration == 0 and position &gt;= 3600">{{position:duration:hh:mm:ss}}</text>
              <text id="duration_mmss" size="10%" align="end" visible="true" visibleWhen="duration !=0 and duration &lt; 3600">{{position:duration:mm:ss}} / {{duration:duration:mm:ss}}</text>
              <text id="duration_hhmmss" size="10%" align="end" visible="true" visibleWhen="duration &gt;= 3600">{{position:duration:hh:mm:ss}} / {{duration:duration:hh:mm:ss}}</text>
            </stack>
          </stack>
        </stack>
      </stack>
    </stack>
  </layer>
  <stack id="notConnected" direction="vertical" justify="center" align="center" visible="true" visibleWhen="connected == false" interactive="true">
    <text id="notConnected_text1" size="12%" align="center">Not connected to</text>
    <text id="notConnected_text2" size="12%" align="center">WebNowPlaying</text>
    <text id="notConnected_text3" size="12%" align="center">(Touch to check data)</text>
  </stack>
</stack>
