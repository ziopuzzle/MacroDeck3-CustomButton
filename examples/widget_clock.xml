<stack id="content" padding="10%" gap="0%" background="#1a1a1a" direction="vertical" justify="center" align="center">
  <text id="label" size="8%" align="center" role="secondary" visible="true" visibleWhen="label">{{label}}</text>
  <clock id="clock" zone="{{timezone}}" seconds="{{showSeconds}}" visible="true" visibleWhen="digital == false" />
  <dynamic-text id="time" format="{{timeFormat}}" seconds="true" size="20%" align="center" visible="true" visibleWhen="digital == true" />
  <dynamic-text id="date" format="{{dateFormat}}" size="10%" align="center" role="muted" />
</stack>
