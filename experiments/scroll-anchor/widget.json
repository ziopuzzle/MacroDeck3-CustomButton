{
  "channel": "scroll-anchor-probe",
  "layout": "<stack id=\"c\" background=\"#1a1a1a\" gap=\"0%\">\n  <stack id=\"run\" interactive=\"true\" mainSize=\"20%\" background=\"#335577\" justify=\"center\" align=\"center\">\n    <text id=\"runLabel\" size=\"7%\">Run probe / phase {{phase}}</text>\n  </stack>\n  <scroll id=\"v\" mainSize=\"75%\" fill=\"false\" anchor=\"start\">\n    <style when=\"phase == 1 or phase == 2\" anchor=\"end\" />\n    <repeat id=\"r\" items=\"{{rows}}\" itemKey=\"id\">\n      <modifier id=\"frame\" height=\"25%\" visibleWhen=\"phase == 0 or phase == 4 or (phase == 1 and index &lt; 5) or ((phase == 2 or phase == 3) and index &lt; 6)\">\n        <stack id=\"row\" justify=\"center\" align=\"center\" background=\"#293340\">\n          <style when=\"item.id == 5\" background=\"#805f12\" />\n          <text id=\"label\" size=\"10%\">Row {{item.id}}</text>\n        </stack>\n      </modifier>\n    </repeat>\n  </scroll>\n</stack>\n",
  "initialValues": "{\"phase\":0,\"rows\":[{\"id\":1},{\"id\":2},{\"id\":3},{\"id\":4},{\"id\":5},{\"id\":6},{\"id\":7},{\"id\":8}]}",
